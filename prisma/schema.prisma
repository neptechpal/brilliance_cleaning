generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(STAFF)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
}

// ─── Leads & tracking ────────────────────────────────────────────────

enum LeadStatus {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
  SPAM
}

model Lead {
  id            Int        @id @default(autoincrement())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  status        LeadStatus @default(NEW)
  formType      String // quote | quick | contact | callback
  name          String
  phone         String
  email         String?
  suburb        String?
  postcode      String?
  serviceSlug   String?
  serviceName   String?
  propertyType  String?
  bedrooms      Int?
  bathrooms     Int?
  preferredDate String?
  frequency     String?
  message       String?
  extras        Json?
  valueAud      Int? // quoted / won job value in dollars

  // attribution
  pagePath    String? // page the form was submitted on
  landingPage String? // first page of the session
  referrer    String?
  channel     String? // google-organic | google-ads | bing-organic | facebook | direct | referral | email | other
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  gclid       String?
  fbclid      String?
  msclkid     String?
  firstTouch  Json? // { channel, source, medium, campaign, landingPage, referrer, at }
  visitorId   String?
  device      String?
  userAgent   String?
  ipHash      String?

  spamReason String?
  emailSent  Boolean    @default(false)
  emailError String?
  notes      LeadNote[]

  @@index([createdAt])
  @@index([status])
  @@index([channel])
}

model LeadNote {
  id         Int      @id @default(autoincrement())
  leadId     Int
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  body       String
  authorName String?
  createdAt  DateTime @default(now())

  @@index([leadId])
}

// call_click | sms_click | email_click | whatsapp_click | quote_cta | form_start | pageview
model TrackEvent {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  type        String
  label       String? // where on the page: header, hero, sticky-mobile, footer, service-cta …
  target      String? // phone number / email / href
  pagePath    String
  landingPage String?
  referrer    String?
  channel     String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  gclid       String?
  visitorId   String?
  device      String?
  ipHash      String?

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([pagePath])
}

// ─── Content ─────────────────────────────────────────────────────────

model Service {
  id              Int      @id @default(autoincrement())
  slug            String   @unique
  name            String
  category        String // residential | commercial | specialist
  active          Boolean  @default(true)
  featured        Boolean  @default(false)
  sortOrder       Int      @default(0)
  icon            String?
  metaTitle       String?
  metaDescription String?
  h1              String?
  heroIntro       String?
  summary         String?
  body            String   @default("")
  inclusions      Json     @default("[]") // [{ area, items: [] }]
  exclusions      String[]
  process         Json     @default("[]") // [{ title, text }]
  idealFor        String[]
  faqs            Json     @default("[]") // [{ q, a }]
  keywords        String[]
  related         String[]
  priceFrom       Int? // dollars, shown only when set
  priceNote       String?
  image           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Area {
  id              Int      @id @default(autoincrement())
  slug            String   @unique
  name            String
  region          String // hub slug
  isHub           Boolean  @default(false)
  postcode        String?
  lat             Float?
  lng             Float?
  metaTitle       String?
  metaDescription String?
  h1              String?
  intro           String   @default("")
  localContent    String   @default("")
  landmarks       String[]
  nearby          String[]
  topServices     String[]
  faqs            Json     @default("[]")
  active          Boolean  @default(true)
  indexable       Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([region])
}

model ServiceArea {
  id              Int      @id @default(autoincrement())
  serviceSlug     String
  areaSlug        String
  metaTitle       String?
  metaDescription String?
  h1              String?
  intro           String   @default("")
  localTips       String[]
  active          Boolean  @default(true)
  indexable       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([serviceSlug, areaSlug])
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

model Post {
  id              Int        @id @default(autoincrement())
  slug            String     @unique
  title           String
  metaTitle       String?
  metaDescription String?
  excerpt         String?
  category        String     @default("Guides")
  tags            String[]
  readMinutes     Int        @default(5)
  body            String     @default("")
  faqs            Json       @default("[]")
  relatedServices String[]
  coverImage      String?
  authorName      String     @default("Brilliance Cleaning Team")
  status          PostStatus @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status, publishedAt])
}

model Faq {
  id        Int     @id @default(autoincrement())
  q         String
  a         String
  category  String  @default("General")
  sortOrder Int     @default(0)
  active    Boolean @default(true)
}

// Real customer reviews only (copied from Google Business Profile etc.)
model Review {
  id          Int       @id @default(autoincrement())
  author      String
  rating      Int       @default(5)
  text        String
  source      String    @default("Google")
  reviewDate  DateTime?
  suburb      String?
  serviceSlug String?
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
}

// ─── SEO ─────────────────────────────────────────────────────────────

model Redirect {
  id        Int       @id @default(autoincrement())
  from      String    @unique // path, e.g. /old-page
  to        String? // null for 410
  code      Int       @default(301) // 301 | 302 | 410
  hits      Int       @default(0)
  lastHitAt DateTime?
  note      String?
  createdAt DateTime  @default(now())
}

// Overrides for fixed pages (home, about, contact, …)
model PageSeo {
  id              Int      @id @default(autoincrement())
  path            String   @unique
  metaTitle       String?
  metaDescription String?
  noindex         Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

// Content strategy / keyword planner
model Keyword {
  id         Int      @id @default(autoincrement())
  keyword    String   @unique
  intent     String   @default("commercial") // local | commercial | informational | transactional
  cluster    String? // e.g. "End of lease"
  volume     Int?
  difficulty Int?
  targetUrl  String?
  status     String   @default("IDEA") // IDEA | PLANNED | WRITING | PUBLISHED | RANKING
  priority   Int      @default(2) // 1 high · 2 medium · 3 low
  position   Float? // latest Google position (from Search Console)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ─── Staffing: job applications ("Join our team") ────────────────────

enum ApplicationStatus {
  NEW
  REVIEWING
  INTERVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

model StaffApplication {
  id             Int               @id @default(autoincrement())
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  status         ApplicationStatus @default(NEW)
  firstName      String
  lastName       String
  email          String?
  phone          String?
  experience     String
  roles          String[] // Cook, Chef, Kitchen Hand, Cleaner
  expertise      String[] // cuisines / sections / skills
  qualifications String[]
  workRights     String?
  employmentType String[] // PAYG (TFN) | ABN Contractor
  locations      String
  languages      String?
  linkedinUrl    String?
  shiftTypes     String[] // Casual | Part-time | Full-time | Event/On-call
  ownTransport   Boolean           @default(false)
  availability   String[] // "Mon:morning", "Sat:night" …
  referee1       String?
  referee2       String?
  emergencyName  String?
  emergencyPhone String?
  consent        Boolean           @default(false)
  signature      String
  rating         Int? // internal 1–5
  active         Boolean           @default(false) // shown to venues in the /booking staff-preference picker
  source         String            @default("form") // form | admin | wordpress
  bio            String?
  legacyId       Int?              @unique // WordPress hos_staff post id

  pagePath    String?
  referrer    String?
  channel     String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  visitorId   String?
  device      String?
  userAgent   String?
  ipHash      String?
  spamReason  String?
  emailSent   Boolean @default(false)
  emailError  String?

  files ApplicantFile[]
  notes ApplicationNote[]

  @@index([createdAt])
  @@index([status])
}

model ApplicantFile {
  id            Int              @id @default(autoincrement())
  applicationId Int
  application   StaffApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind          String // photo | resume | certificate
  originalName  String
  mime          String
  size          Int
  storedName    String           @unique
  createdAt     DateTime         @default(now())

  @@index([applicationId])
}

model ApplicationNote {
  id            Int              @id @default(autoincrement())
  applicationId Int
  application   StaffApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  body          String
  authorName    String?
  createdAt     DateTime         @default(now())

  @@index([applicationId])
}

// ─── Hospitality staff bookings (venues requesting chefs, cooks, kitchen hands, cleaners) ──

enum BookingStatus {
  NEW
  CONFIRMED
  FILLED
  COMPLETED
  CANCELLED
}

model StaffBooking {
  id                Int           @id @default(autoincrement())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  status            BookingStatus @default(NEW)
  venue             String
  address           String
  contactName       String
  contactPhone      String
  contactEmail      String
  position          String
  rateAud           Float? // base rate at time of booking (ex GST)
  date              String // YYYY-MM-DD (Sydney)
  startTime         String // HH:MM
  endTime           String
  quantity          Int           @default(1)
  notes             String?
  estimateAud       Float? // live estimate shown to the client (ex GST)
  preferredStaffIds Int[]
  assignedStaffIds  Int[]
  activity          Json          @default("[]") // [{ at, actor, type, message }]
  acceptedPolicies  Boolean       @default(false)

  pagePath    String?
  channel     String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  gclid       String?
  visitorId   String?
  device      String?
  ipHash      String?
  legacyId    Int?    @unique

  @@index([createdAt])
  @@index([status])
  @@index([date])
}

// ─── Roster (replaces the WordPress "BR Roster" / SJ Cleaning Staff Portal) ─────────────

model CostCentre {
  id             Int        @id @default(autoincrement())
  name           String     @unique
  address        String?
  contactName    String?
  contactPhone   String?
  notes          String?
  geofenceRadius Int        @default(200) // metres; 0 = no geofence
  lat            Float?
  lng            Float?
  active         Boolean    @default(true)
  legacyId       Int?       @unique
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  employees      Employee[]
  shifts         Shift[]
}

model Employee {
  id              Int          @id @default(autoincrement())
  firstName       String
  lastName        String
  email           String       @unique // also the portal username
  passwordHash    String?
  mustSetPassword Boolean      @default(false)
  phone           String
  address         String?
  emergencyName   String?
  emergencyPhone  String?
  comments        String?
  costCentreId    Int?
  costCentre      CostCentre?  @relation(fields: [costCentreId], references: [id], onDelete: SetNull)
  active          Boolean      @default(true)
  color           String?
  lastLoginAt     DateTime?
  legacyUserId    Int?         @unique // WordPress user id
  legacyEmpId     Int?         @unique // wp_sj_employees.id
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  shifts          Shift[]
  attendance      Attendance[]

  @@index([active])
}

enum ShiftStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Shift {
  id           Int          @id @default(autoincrement())
  employeeId   Int
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  costCentreId Int?
  costCentre   CostCentre?  @relation(fields: [costCentreId], references: [id], onDelete: SetNull)
  siteName     String
  siteAddress  String?
  siteLat      Float?
  siteLng      Float?
  date         String // YYYY-MM-DD, Sydney local
  startTime    String // HH:MM
  endTime      String // HH:MM (may be earlier than start for overnight shifts)
  notes        String?
  status       ShiftStatus  @default(SCHEDULED)
  legacyId     Int?         @unique
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  attendance   Attendance[]

  @@index([date])
  @@index([employeeId, date])
}

enum AttendanceStatus {
  PENDING
  APPROVED
  DECLINED
}

model Attendance {
  id              Int              @id @default(autoincrement())
  employeeId      Int
  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftId         Int?
  shift           Shift?           @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  signInAt        DateTime?
  signInLat       Float?
  signInLng       Float?
  signInAccuracy  Float?
  signInAddress   String?
  signInDistance  Int? // metres from the site when signing in
  signOutAt       DateTime?
  signOutLat      Float?
  signOutLng      Float?
  signOutAccuracy Float?
  signOutAddress  String?
  signOutDistance Int?
  notes           String?
  status          AttendanceStatus @default(PENDING)
  paid            Boolean          @default(false)
  manual          Boolean          @default(false) // entered/edited by an admin
  editedBy        String?
  legacyId        Int?             @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([employeeId, signInAt])
  @@index([signInAt])
  @@index([status])
}
